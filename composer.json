{
    "name": "arrue/erronka2-web",
    "description": "Arrue Erronka 2 - PHP webgunearen kalitate-kontrolak",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "platform": {"php": "8.3.0"},
        "sort-packages": true,
        "allow-plugins": false
    },
    "scripts": {
        "lint": "@php tools/lint.php",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit",
        "check": ["@lint", "@analyse", "@test"]
    }
}
